rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each account's own data: per-space diffs (added/modified/removed vs
    // whatever base that space uses) + small metadata docs (their custom
    // shelf list, and which shared-base version they're currently pinned
    // to). Only that account can ever read or write its own subtree.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /spaceData/{spaceId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /meta/{metaId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // The official 總表/招式庫 (space-index) shared base: everyone (including
    // signed-out visitors) can read it, but only the one admin account can
    // publish new versions.
    match /sharedBase/space-index {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "2PFyyWWVrANFAsSxVHgsk3QHUlT2";

      match /versions/{version} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == "2PFyyWWVrANFAsSxVHgsk3QHUlT2";
      }
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
