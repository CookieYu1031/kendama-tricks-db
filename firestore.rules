rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Admins are listed in the admins collection (created by hand in the
    // Firebase console). No UID is hardcoded here.
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Contributors (協助者) are listed by lowercase Gmail in contributors/{email} (v0.7 D2).
    function isContributor() {
      return signedIn() && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/contributors/$(request.auth.token.email.lower()));
    }

    // admins/{uid}: a user may only check their own entry. Never writable
    // from clients; manage in the console.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Root user doc is unused by the app: owner read only, no client writes.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /meta/{metaId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && (
          (metaId == 'spaces' &&
            request.resource.data.keys().hasOnly(['spaces', 'tags', 'schema', 'clientUpdatedAt', 'updatedAt']) &&
            (!('spaces' in request.resource.data) ||
              (request.resource.data.spaces is list && request.resource.data.spaces.size() <= 40)) &&
            (!('tags' in request.resource.data) ||
              (request.resource.data.tags is list && request.resource.data.tags.size() <= 2000)) &&
            (!('schema' in request.resource.data) || request.resource.data.schema is int) &&
            (!('clientUpdatedAt' in request.resource.data) || request.resource.data.clientUpdatedAt is number) &&
            (!('updatedAt' in request.resource.data) ||
              (request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt == request.time)))
          ||
          (metaId == 'spaceIndexSync' &&
            request.resource.data.keys().hasOnly(['viewingVersion', 'updatedAt']) &&
            (!('viewingVersion' in request.resource.data) ||
              (request.resource.data.viewingVersion is int && request.resource.data.viewingVersion >= 0)) &&
            (!('updatedAt' in request.resource.data) ||
              (request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt == request.time)))
        );
      }

      match /spaceData/{sid} {
        // Read/delete stay open to the owner so old schema-2 docs can be
        // read and cleaned up.
        // list is separate: a collection query can't prove a condition on the doc id
        // wildcard, so `sid.matches` on list denied every spaceData query (pull failed).
        allow get, delete: if isOwner(uid) && sid.matches('^[0-9A-Za-z_-]{1,40}$');
        allow list: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          sid.matches('^[0-9A-Za-z_-]{1,40}$') &&
          request.resource.data.keys().hasOnly(['schema', 'baseVersion', 'chunks', 'hash', 'updatedAt']) &&
          request.resource.data.schema == 3 &&
          request.resource.data.chunks is int &&
          request.resource.data.chunks >= 0 && request.resource.data.chunks <= 50 &&
          request.resource.data.hash is string && request.resource.data.hash.size() <= 128 &&
          request.resource.data.baseVersion is int && request.resource.data.baseVersion >= 0 &&
          (!('updatedAt' in request.resource.data) ||
            (request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt == request.time));

        match /chunks/{i} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) &&
            sid.matches('^[0-9A-Za-z_-]{1,40}$') &&
            i.matches('^[0-9]{1,2}$') &&
            request.resource.data.keys().hasOnly(['data']) &&
            request.resource.data.data is string &&
            request.resource.data.data.size() <= 1000000;
        }
      }
    }

    // Official shared base: public read, admin-only write.
    match /sharedBase/space-index {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['latestVersion', 'latestNote', 'latestLabel', 'publishedAt']) &&
        (!('latestVersion' in request.resource.data) || request.resource.data.latestVersion is int) &&
        (!('latestNote' in request.resource.data) ||
          (request.resource.data.latestNote is string && request.resource.data.latestNote.size() <= 500)) &&
        (!('latestLabel' in request.resource.data) ||
          (request.resource.data.latestLabel is string && request.resource.data.latestLabel.size() <= 32));

      match /versions/{v} {
        allow read: if true;
        allow delete: if isAdmin();
        allow create, update: if isAdmin() &&
          v.matches('^[0-9]{1,6}$') &&
          request.resource.data.keys().hasOnly(['version', 'note', 'versionLabel', 'publishedAt', 'chunks']) &&
          (!('version' in request.resource.data) || request.resource.data.version is int) &&
          (!('note' in request.resource.data) ||
            (request.resource.data.note is string && request.resource.data.note.size() <= 500)) &&
          (!('versionLabel' in request.resource.data) ||
            (request.resource.data.versionLabel is string && request.resource.data.versionLabel.size() <= 32)) &&
          (!('chunks' in request.resource.data) ||
            (request.resource.data.chunks is int && request.resource.data.chunks >= 0 && request.resource.data.chunks <= 50));

        match /chunks/{i} {
          allow read: if true;
          allow delete: if isAdmin();
          allow create, update: if isAdmin() &&
            i.matches('^[0-9]{1,2}$') &&
            request.resource.data.keys().hasOnly(['data']) &&
            request.resource.data.data is string &&
            request.resource.data.data.size() <= 1000000;
        }
      }
    }

    match /contributors/{emailId} {
      allow read: if isAdmin() ||
        (signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == emailId);
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['email', 'addedAt', 'color']) &&
        request.resource.data.email is string &&
        request.resource.data.email.lower() == emailId &&
        request.resource.data.color is string &&
        request.resource.data.color.matches('^#[0-9A-Fa-f]{6}$');
      allow delete: if isAdmin();
    }
    // submissions/{subId}: contributor trick submissions awaiting admin review.
    match /submissions/{subId} {
      allow create: if isContributor() &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'trick', 'parentId', 'status', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email.lower() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.name is string && request.resource.data.name.size() <= 60 &&
        request.resource.data.parentId is string && request.resource.data.parentId.size() <= 64 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.trick is map &&
        request.resource.data.trick.keys().hasOnly(['id', 'name', 'media', 'icon', 'color', 'grip', 'parts', 'officialNote', 'tagIds']) &&
        request.resource.data.trick.name is map &&
        request.resource.data.trick.media is list && request.resource.data.trick.media.size() <= 10 &&
        request.resource.data.trick.officialNote is string && request.resource.data.trick.officialNote.size() <= 2000;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // reports/{rid}: problem reports, trick submissions from the form, contributor applications (v0.7 D5).
    // Rate limit: the same batch must stamp rateLimits/{uid}.lastReportAt = now, and the previous stamp must be >60s old.
    match /reports/{rid} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'kind', 'text', 'payload', 'createdAt', 'status']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.kind in ['bug', 'erratum', 'suggestion', 'other', 'trick', 'apply'] &&
        request.resource.data.status == 'open' &&
        request.resource.data.text is string && request.resource.data.text.size() <= 1000 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 200 &&
        request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60 &&
        request.resource.data.payload is map && request.resource.data.payload.keys().size() <= 4 &&
        request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.lastReportAt == request.time &&
        (!exists(/databases/$(database)/documents/rateLimits/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.lastReportAt + duration.value(60, 's') < request.time);
      allow read, update, delete: if isAdmin();
    }
    match /rateLimits/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['lastReportAt']) &&
        request.resource.data.lastReportAt == request.time;
      allow delete: if false;
    }
    // users/{uid}/inbox/{mid}: admin -> user in-app messages.
    match /users/{uid}/inbox/{mid} {
      allow read, delete: if isOwner(uid);
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly(['kind', 'text', 'trickName', 'from', 'createdAt', 'read']) &&
        request.resource.data.text is string && request.resource.data.text.size() <= 1000 &&
        (!('trickName' in request.resource.data) ||
          (request.resource.data.trickName is string && request.resource.data.trickName.size() <= 120)) &&
        request.resource.data.from == 'admin' && request.resource.data.read == false &&
        request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // userStats/{uid}: per-user aggregate for admin stats (v0.7 D6). Owner writes, admin reads.
    match /userStats/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['lang', 'favorites', 'landed', 'rates', 'lastActiveAt', 'createdAt']) &&
        request.resource.data.lang in ['zh', 'jp', 'en'] &&
        request.resource.data.favorites is list && request.resource.data.favorites.size() <= 2000 &&
        request.resource.data.landed is list && request.resource.data.landed.size() <= 2000 &&
        request.resource.data.rates is map && request.resource.data.rates.keys().size() <= 2000 &&
        (resource == null || !('createdAt' in resource.data) ||
          request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isOwner(uid);
    }

    // shares/{shareId}: one-click share snapshots (v0.9.1). Doc id = <ownerUid>_<itemId>. Anyone with the
    // link reads; only the owner writes (the same item is re-shared by overwriting) or deletes.
    // payload is a JSON string (<= 200 KB).
    match /shares/{shareId} {
      allow read: if true;
      allow create, update: if signedIn() &&
        request.resource.data.keys().hasOnly(['ownerUid', 'itemId', 'createdAt', 'kind', 'title', 'payload', 'v']) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.itemId is string &&
        request.resource.data.itemId.matches('^[0-9A-Za-z_-]{1,40}$') &&
        shareId == request.auth.uid + '_' + request.resource.data.itemId &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.kind in ['folder', 'trick'] &&
        request.resource.data.title is string && request.resource.data.title.size() <= 120 &&
        request.resource.data.payload is string && request.resource.data.payload.size() <= 204800 &&
        request.resource.data.v == 1;
      allow delete: if isOwner(resource.data.ownerUid);
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
